{
  "name": "wallet",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check . --write",
    "typecheck": "yarn workspaces foreach --all --topological run typecheck",
    "test": "yarn workspaces foreach --all run test",
    "build": "yarn workspaces foreach --all --topological run build",
    "verify": "yarn lint && yarn build && yarn typecheck && yarn test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "typescript": "^7.0.2"
  },
  "resolutions": {
    "deepmerge-ts": "^8.0.2",
    "workbox-build/glob": "^13.0.6",
    "prisma/mysql2": "^3.22.0"
  }
}
