{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!.yarn/",
      "!**/dist/",
      "!**/coverage/",
      "!.gitleaks-baseline.json",
      "!apps/web/src/styles/tokens.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@wallet/api",
                      "**/apps/api/**",
                      "**/api/src/**",
                      "@wallet/web",
                      "**/apps/web/**",
                      "**/web/src/**"
                    ],
                    "message": "packages/shared imports nothing (spec 8.2). A dependency here inverts the direction: the contract would need one of its own consumers in order to build."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@wallet/web", "**/apps/web/**", "**/web/src/**"],
                    "message": "apps/* never import each other (spec 8.2). Anything both sides need belongs in packages/shared."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@wallet/api", "**/apps/api/**", "**/api/src/**"],
                    "message": "apps/* never import each other (spec 8.2). Anything both sides need belongs in packages/shared — that is what sent USSD_PIN_PROMPT there."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
