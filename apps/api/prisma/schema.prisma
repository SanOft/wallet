// Wallet data model — spec §9.1.
//
// Money is BIGINT in minor units everywhere (§9.3, NFR-1.10). There is no
// Float or Decimal column in this file and there must never be one: a rounding
// error in a ledger is not a display bug, it is missing money.
//
// The invariants that protect the ledger (§9.5) are enforced as database CHECK
// constraints, added by hand in the migration SQL because Prisma has no schema
// syntax for them. They are listed on each model below so the two stay in sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  SYSTEM
}

enum AccountType {
  USER
  TREASURY
}

enum TransferStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TransferType {
  P2P
  TOPUP
}

enum TransferChannel {
  WEB
  USSD
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  phone            String    @unique
  firstName        String
  lastName         String
  /// Argon2id (NFR-1.1). Never leaves the server; publicUserSchema strips it.
  passwordHash     String
  /// Argon2id. Null until the user sets a USSD PIN in the profile (FR-1.6).
  pinHash          String?
  pinLockedUntil   DateTime?
  role             UserRole  @default(USER)
  /// Access tokens issued before this instant are refused on the money routes
  /// (FR-2.6, P-16).
  ///
  /// A JWT is self-contained, so revoking a refresh family reaches the refresh
  /// token immediately and leaves the attacker's *access* token working until
  /// it expires — up to fifteen minutes on the endpoints where fifteen minutes
  /// matters. This column is the revocation list, kept to one nullable
  /// timestamp instead of a table: null is the ordinary case and costs the
  /// lookup nothing.
  ///
  /// Set by reuse detection, which is the moment something is known to be
  /// stolen. Not by an ordinary logout: that ends one session, and this would
  /// end every one the user has on every device.
  tokensValidAfter DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  accounts      Account[]
  refreshTokens RefreshToken[]
  authAttempts  AuthAttempt[]
  idempotency   IdempotencyRecord[]
  transfers     Transfer[]          @relation("TransfersInitiated")

  @@map("users")
}

/// CHECK: balance >= 0 unless type = TREASURY (I-5, §9.4).
model Account {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  currency  String      @default("UZS")
  /// Cached snapshot in minor units. Derived from the ledger, never the source
  /// of truth (FR-3.2, I-4); reconciliation compares the two daily.
  balance   BigInt      @default(0)
  type      AccountType @default(USER)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]
  transfersSent Transfer[]    @relation("TransfersSent")
  transfersGot  Transfer[]    @relation("TransfersReceived")

  @@unique([userId, currency])
  @@index([userId])
  @@map("accounts")
}

/// CHECK: amount > 0 (FR-4.7).
/// CHECK: completedAt is set only when status = COMPLETED.
model Transfer {
  id             String          @id @default(uuid()) @db.Uuid
  fromAccountId  String          @db.Uuid
  toAccountId    String          @db.Uuid
  /// Minor units, strictly positive. Direction lives in the ledger pair.
  amount         BigInt
  status         TransferStatus  @default(PENDING)
  type           TransferType    @default(P2P)
  channel        TransferChannel @default(WEB)
  /// Who asked for this transfer.
  ///
  /// Not derivable from the accounts: for a P2P transfer it is the sender, for
  /// a demo top-up it is the *recipient*, because the money leaves the treasury
  /// (§9.4). The idempotency key is scoped to this rather than to an account,
  /// so scoping the record without scoping the transfer would only move the
  /// collision one layer down.
  initiatedBy    String          @db.Uuid
  /// Client-generated UUID v4, mandatory on every money-moving call (FR-4.4).
  idempotencyKey String
  failReason     String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?

  initiator     User          @relation("TransfersInitiated", fields: [initiatedBy], references: [id])
  fromAccount   Account       @relation("TransfersSent", fields: [fromAccountId], references: [id])
  toAccount     Account       @relation("TransfersReceived", fields: [toAccountId], references: [id])
  ledgerEntries LedgerEntry[]

  @@unique([initiatedBy, idempotencyKey])
  @@index([fromAccountId, createdAt])
  @@index([toAccountId, createdAt])
  @@map("transfers")
}

/// The journal. Append-only by construction (I-3): the repository exposes no
/// update or delete, and a database rule rejects both.
///
/// CHECK: amount <> 0 — a zero entry carries no information and would let a
/// transfer satisfy "two rows summing to zero" while moving nothing.
model LedgerEntry {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @db.Uuid
  transferId   String   @db.Uuid
  /// Signed minor units: negative debits the account, positive credits it.
  amount       BigInt
  /// Account balance immediately after this entry, making an audit O(1) (§9.2).
  ///
  /// Verified at COMMIT against the entry's predecessor on the same account
  /// (P-21). Until that check existed nothing validated this column at all,
  /// and an audit trail nobody checks is worse than none.
  balanceAfter BigInt
  /// Insertion order, which `createdAt` cannot provide: it defaults to the
  /// transaction timestamp, so every entry one transaction writes shares it.
  /// The COMMIT-time check needs a well-defined predecessor per account.
  seq          BigInt   @unique @default(autoincrement())
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  account  Account  @relation(fields: [accountId], references: [id])
  transfer Transfer @relation(fields: [transferId], references: [id])

  @@index([accountId, createdAt])
  @@index([accountId, seq(sort: Desc)])
  @@index([transferId])
  @@map("ledger_entries")
}

/// CHECK: statusCode between 100 and 599.
model IdempotencyRecord {
  /// Scoped to the user who sent it (P-8).
  ///
  /// The key alone was the primary key, which put every client in one
  /// namespace: one user claiming a key another was about to use turned their
  /// transfer into a 409. Nothing was disclosed — the service already refuses
  /// to replay a record belonging to someone else — but a buggy or hostile
  /// client could block other people's payments with values it chooses.
  key         String
  userId      String   @db.Uuid
  /// SHA-256 of the payload. Distinguishes a replay from a key collision with a
  /// different body, which is a 409 rather than a stored response (FR-4.4).
  requestHash String
  response    Json
  statusCode  Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  /// Creation + 24h (FR-4.4).
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

/// One chain per device. On reuse the whole family is revoked (FR-2.7).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  /// SHA-256 of the opaque token. The raw value is never stored, so a database
  /// leak cannot hijack a session (§9.2).
  tokenHash String    @unique
  /// Non-null means this token has already been exchanged — the reuse detector.
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Lockout counting lives here rather than in a column on User, so the history
/// survives for audit (§9.2, FR-2.3).
model AuthAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  /// Null when the attempt named a number that is not registered.
  ///
  /// It has to be nullable, and the row has to be written either way: recording
  /// only the attempts that match a user made login do one extra INSERT for a
  /// registered number, which was measurable from outside as a ~6ms difference
  /// and classified numbers at 80% accuracy — an enumeration oracle against
  /// FR-2.2 and NFR-1.2. §11.2 draws this write unconditionally.
  userId    String?  @db.Uuid
  /// Keyed digest of the number the attempt named, registered or not (FR-2.3).
  ///
  /// The backoff counts against this rather than against `userId`, because a
  /// counter that only exists for registered numbers turns the fourth attempt
  /// into a membership oracle: 429 for a customer, 401 for a stranger. Keyed
  /// rather than plain, because this column would otherwise be a list of the
  /// phone numbers people tried — a nine-digit space that a bare hash does not
  /// hide. Empty on rows written before the backoff existed.
  subject   String   @default("")
  succeeded Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  /// The backoff reads the recent attempts for one subject, newest first.
  @@index([subject, createdAt])
  @@map("auth_attempts")
}

/// The last exchange rates this deployment successfully read (FR-7.2, P-30).
///
/// A cache in a table, which is unusual enough to justify. FR-7.2 promises the
/// last known value when the central bank is unreachable; an in-process cache
/// keeps that promise only for a process that has been running, and P-27
/// records that a free-tier instance sleeps, so a cold start with the bank down
/// had no fallback at all. It also lets a second instance reuse the first's
/// reading rather than each paying its own request.
///
/// One row, not an append-only log. FR-7.3 makes these numbers informational —
/// nothing is priced or decided from them — so there is no question anyone
/// would ask of a history. When conversion arrives it will need to record which
/// rate applied to which transaction, which is a different table from this one.
model RatesSnapshot {
  /// Always `ROW_ID`. A primary key with one legal value is how "exactly one
  /// row" is stated to the database rather than hoped for in the application.
  id        String   @id
  /// The `Rate[]` the client contract describes, validated on the way back out
  /// — a row written by an older version of this code is not to be trusted
  /// simply because we wrote it.
  payload   Json
  /// When the upstream was read, not when the row was written. This is the
  /// date the user is shown beside a stale value.
  fetchedAt DateTime @db.Timestamptz(3)

  @@map("rates_snapshots")
}
