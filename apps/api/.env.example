# Neon connection string (spec §20.2). Never commit the real value.
#
# This is the POOLED one — the hostname contains `-pooler`. It is what the
# running service uses.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require"

# The same database without the pooler. Used only by `prisma migrate deploy`,
# which takes advisory locks and issues DDL across several statements — work a
# transaction pooler may hand to different backends, half-applying the
# migration. Neon's Prisma guide requires the direct connection for this.
#
# Leave unset locally and in CI, where there is no pooler and the two hostnames
# are the same; the config falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Where the integration tests run (P-31). Optional, and worth setting locally.
#
# Without it the tests share a database with whatever you are developing
# against — and they write. A fixture then becomes a row the running app serves
# to a real session, which is how the rates widget once showed a rate dated
# tomorrow, taken from a test file, for hours. The tests also leave everything
# they create behind: thousands of accounts accumulate and whole-database
# invariant checks start timing out.
#
# Create it once:
#   createdb wallet_test              (or: CREATE DATABASE wallet_test;)
#   TEST_DATABASE_URL=... yarn workspace @wallet/api exec prisma migrate deploy
#
# Left unset in CI on purpose: a throwaway container has nothing to protect.
TEST_DATABASE_URL=

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Explicit allowlist, never "*" (NFR-1.8). Comma-separated.
#
# The PWA no longer depends on this — it is same-origin under ADR-0009. Kept for
# non-browser callers and as defence in depth. Rejected values: "*", "null",
# and plain http for anything but localhost.
CORS_ORIGINS=http://localhost:5173

# HS256 signing secret, at least 32 characters (256 bits).
# Generate one with:  node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
#
# Left empty on purpose. A placeholder long enough to look like the real thing
# is indistinguishable from the real thing to a secret scanner, and the way that
# was previously resolved — allowlisting this whole file — blinded the scanner
# to the one file that documents every production secret. An empty value cannot
# match, needs no exception, and fails the boot check until someone sets it.
JWT_SECRET=

# Production domain for the refresh cookie.
#
# Leave unset. Under ADR-0009 the PWA reaches the API through its own origin, so
# the cookie is already same-site and needs no domain. Set it only once the two
# services share a registered parent domain (app.example.uz / api.example.uz),
# which is the point at which the rewrite can be deleted.
# REFRESH_COOKIE_DOMAIN=wallet.example.com

# USSD gateway shared secret (spec §20.2, FR-9.1), at least 32 characters.
#
# Optional, and unset is the expected state: the MVP has no shortcode, only the
# browser simulator (FR-9.6), which authenticates with the user's own session
# and never sees this value. What matters is the direction of the default — with
# no secret configured, `POST /api/channels/ussd` refuses every caller, because
# "not configured yet" and "open to the internet" must not be the same
# deployment. Left empty: see JWT_SECRET.
# USSD_GATEWAY_SECRET=
